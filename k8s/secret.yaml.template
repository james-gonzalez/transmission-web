# Create the secret with:
# kubectl create secret generic transmission-web-secret \
#   --from-literal=password='YOUR_PASSWORD' \
#   --from-literal=transmission_url='http://YOUR_TRANSMISSION_HOST:9091/transmission/rpc' \
#   -n default
#
# Or apply this file after base64 encoding your values:
# echo -n 'YOUR_PASSWORD' | base64
# echo -n 'http://YOUR_TRANSMISSION_HOST:9091/transmission/rpc' | base64
#
# Then replace PASSWORD_BASE64 and TRANSMISSION_URL_BASE64 below with the output

apiVersion: v1
kind: Secret
metadata:
  name: transmission-web-secret
  namespace: default
type: Opaque
data:
  password: PASSWORD_BASE64  # Replace with base64 encoded password
  transmission_url: TRANSMISSION_URL_BASE64  # Replace with base64 encoded Transmission RPC URL
