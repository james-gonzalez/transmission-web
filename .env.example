# Copy to .env and edit, then run: docker compose up -d

# RPC endpoint of your Transmission daemon. Required.
# If Transmission runs on the Docker host rather than in a container, use the
# host's LAN address, or host.docker.internal on Docker Desktop.
TRANSMISSION_URL=http://transmission.example.com:9091/transmission/rpc

TRANSMISSION_USER=transmission
TRANSMISSION_PASS=
